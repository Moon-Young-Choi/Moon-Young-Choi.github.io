1:[[["$","link","css:/assets/index-DStW-UAj.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/assets/index-DStW-UAj.css","data-rsc-css-href":"/assets/index-DStW-UAj.css"}],"$undefined"],["$","main",null,{"className":"_page_r7ckf_1","style":{"--paper-accent":"var(--coral)"},"children":[["$","header",null,{"className":"site-header _nav_r7ckf_2","children":[["$","$L6",null,{"className":"wordmark","href":"/","children":"MYC / 26"}],["$","nav",null,{"aria-label":"EventEdge Derivatives paper navigation","children":[["$","a",null,{"href":"#paper-contents","children":"Contents"}],["$","a",null,{"href":"#references","children":"References"}]]}],["$","$L6",null,{"className":"header-link","href":"/#projects","children":"Close ×"}]]}],["$","article",null,{"className":"_paper_r7ckf_3","children":[["$","header",null,{"className":"_masthead_r7ckf_4","data-paper-header":true,"children":[["$","div",null,{"className":"_runningHead_r7ckf_5","children":[["$","span",null,{"children":["Project ","04"]}],["$","span",null,{"children":"Incomplete-information market simulator"}],["$","span",null,{"children":"Private simulator · reconstructed interface"}]]}],["$","h1",null,{"children":"EventEdge Derivatives"}],["$","div",null,{"className":"_abstract_r7ckf_7","children":[["$","b",null,{"children":"Abstract."}],["$","p",null,{"children":"EventEdge turns public states from multiple incomplete-information games into a finite derivatives market. Registered terminal payoffs are valued under distinct scenario measures, inventory-aware order books quote depth, and multi-leg requests are accepted only when the combined portfolio satisfies tail-risk and execution constraints. The interactive market below is a deterministic reconstruction: it demonstrates the decision contract without exposing private game state or claiming observed trading performance."}]]}],["$","dl",null,{"className":"_metadata_r7ckf_10","children":[["$","div","Underlyings",{"children":[["$","dt",null,{"children":"Underlyings"}],["$","dd",null,{"children":"Kuhn · Leduc games"}]]}],["$","div","Contracts",{"children":[["$","dt",null,{"children":"Contracts"}],["$","dd",null,{"children":"Futures · options · swaps"}]]}],["$","div","Market",{"children":[["$","dt",null,{"children":"Market"}],["$","dd",null,{"children":"20-level order books"}]]}],["$","div","Source",{"children":[["$","dt",null,{"children":"Source"}],["$","dd",null,{"children":"Private research artifact"}]]}]]}],["$","p",null,{"className":"_keywords_r7ckf_16","children":[["$","b",null,{"children":"Keywords."}]," ","C++ · Linux CLI · Monte Carlo simulation · CVaR · order-book simulation · exact-enumeration/CFR validation"]}],["$","details",null,{"className":"_contents_r7ckf_18","id":"paper-contents","data-paper-toc":true,"children":[["$","summary",null,{"children":["Contents — ",4," sections"]}],["$","ol",null,{"children":[["$","li","market-boundary",{"children":["$","a",null,{"href":"#market-boundary","children":[["$","span",null,{"children":"1"}],"Market and information boundary"]}]}],["$","li","reconstructed-market",{"children":["$","a",null,{"href":"#reconstructed-market","children":[["$","span",null,{"children":"2"}],"Interactive reconstructed market"]}]}],["$","li","valuation-mechanics",{"children":["$","a",null,{"href":"#valuation-mechanics","children":[["$","span",null,{"children":"3"}],"Valuation, CVaR, quoting, and atomic fill"]}]}],["$","li","evidence-status",{"children":["$","a",null,{"href":"#evidence-status","children":[["$","span",null,{"children":"4"}],"Evidence status"]}]}]]}]]}]]}],["$","div",null,{"className":"_body_r7ckf_26","children":[[[["$","link","css:/assets/index-DStW-UAj.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/assets/index-DStW-UAj.css","data-rsc-css-href":"/assets/index-DStW-UAj.css"}],"$undefined"],["$","section",null,{"className":"_section_r7ckf_27","id":"market-boundary","data-paper-section":true,"aria-labelledby":"market-boundary-title","children":[["$","header",null,{"className":"_sectionHead_r7ckf_28","children":[["$","span",null,{"children":"1"}],["$","div",null,{"children":[["$","h2",null,{"id":"market-boundary-title","children":"Market and information boundary"}],["$","p",null,{"children":"A trade can use the frozen public snapshot and registered future branches, but never a private card or realized terminal state."}]]}]]}],"$L7"]}]],"$L8","$L9","$La"]}],"$Lb"]}]]}]]
c:I["e29b6796c888",[],"EventEdgeMarketConsole",1]
7:["$","div",null,{"className":"_sectionContent_r7ckf_32","children":[["$","p",null,{"children":"The underlying processes are independent Kuhn or Leduc games. At a decision checkpoint the engine freezes pot size, public action history, legal actions, public cards, and the registered derivative definitions. Private cards, the random seed, future actions, and the realized terminal state remain inside the game engine. Contracts are traded after the public action and before the next underlying transition; the true state is revealed only after the package decision and settlement boundary have been fixed."}],["$","p",null,{"children":"Terminal histories are merged when they produce the same registered payoff vector. This produces a finite scenario basis shared by every participant. The benchmark generator, market maker, and user may assign different weights to that basis, but they do not receive different payoff definitions. Separating what can happen, what each contract pays, and what each agent believes prevents valuation disagreements from becoming accidental information leakage."}],[[["$","link","css:/assets/index-DStW-UAj.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/assets/index-DStW-UAj.css","data-rsc-css-href":"/assets/index-DStW-UAj.css"}],"$undefined"],["$","ol",null,{"className":"_flow_r7ckf_43","children":[["$","li","Freeze public state",{"children":[["$","span",null,{"children":"01"}],["$","b",null,{"children":"Freeze public state"}]]}],["$","li","Enumerate local futures",{"children":[["$","span",null,{"children":"02"}],["$","b",null,{"children":"Enumerate local futures"}]]}],["$","li","Quote and decide",{"children":[["$","span",null,{"children":"03"}],["$","b",null,{"children":"Quote and decide"}]]}],["$","li","Reveal and settle",{"children":[["$","span",null,{"children":"04"}],["$","b",null,{"children":"Reveal and settle"}]]}]]}]],[[["$","link","css:/assets/index-DStW-UAj.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/assets/index-DStW-UAj.css","data-rsc-css-href":"/assets/index-DStW-UAj.css"}],"$undefined"],["$","aside",null,{"className":"_note_r7ckf_48","children":[["$","b",null,{"children":"Information contract"}],["$","div",null,{"children":["$","p",null,{"children":"The true benchmark distribution is evaluation-only. Neither trading agent can inspect it, the terminal state, or engine-private data before the transaction gate."}]}]]}]],["$","p",null,{"children":"The boundary is enforced across time as well as fields. A quote is labeled by the public snapshot, payoff-registry version, scenario generator, and book sequence that produced it. Advancing an underlying game invalidates the old quote before a new one is published. Settlement references the committed package and its original contract versions, so a later configuration change cannot rewrite an outstanding obligation. This versioned lifecycle makes the simulator suitable for invariant testing even when participants disagree about probabilities."}]]}]
8:[[["$","link","css:/assets/index-DStW-UAj.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/assets/index-DStW-UAj.css","data-rsc-css-href":"/assets/index-DStW-UAj.css"}],"$undefined"],["$","section",null,{"className":"_section_r7ckf_27","id":"reconstructed-market","data-paper-section":true,"aria-labelledby":"reconstructed-market-title","children":[["$","header",null,{"className":"_sectionHead_r7ckf_28","children":[["$","span",null,{"children":"2"}],["$","div",null,{"children":[["$","h2",null,{"id":"reconstructed-market-title","children":"Interactive reconstructed market"}],["$","p",null,{"children":"The compact console preserves perspective, package, notional, book stress, terminal selection, risk decision, execution, and settlement reveal."}]]}]]}],["$","div",null,{"className":"_sectionContent_r7ckf_32","children":[["$","p",null,{"children":"The reconstruction exposes one four-state market with two candidate requests. Changing perspective changes fair values while retaining the same payoff matrix. Book profiles modify available depth and therefore the common fill ratio. Requested notional is evaluated against the user’s existing positions, cash flows, transaction costs, and tail objective rather than as a standalone spread."}],[[["$","link","css:/assets/index-DStW-UAj.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/assets/index-DStW-UAj.css","data-rsc-css-href":"/assets/index-DStW-UAj.css"}],"$undefined"],["$","figure",null,{"className":"_figure_r7ckf_40","data-interactive":"true","children":[["$","div",null,{"className":"_figureBody_r7ckf_42","children":["$","$Lc",null,{"variant":"paper"}]}],["$","figcaption",null,{"children":[["$","b",null,{"children":["Figure ","1","."]}]," ","Deterministic reconstructed market. Terminal information remains locked until Reveal & Settle is activated; no order is submitted."]}]]}]],["$","p",null,{"children":"The console deliberately includes a positive standalone edge that can fail the combined-book gate and a hedge package that may remain acceptable after costs. This makes the distinction between valuation and action observable. A favorable expected payoff is not sufficient when it increases worst-state loss, violates a loss limit, or cannot be filled consistently across legs."}]]}]]}]]
d:T4653,<span class="katex-display"><span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mtable rowspacing="0.25em" columnalign="right left" columnspacing="0em"><mtr><mtd><mstyle scriptlevel="0" displaystyle="true"><msub><mi>V</mi><mi>k</mi></msub></mstyle></mtd><mtd><mstyle scriptlevel="0" displaystyle="true"><mrow><mrow></mrow><mo>=</mo><munderover><mo>∑</mo><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mi>S</mi></munderover><msub><mi>p</mi><mi>s</mi></msub><msub><mi>A</mi><mrow><mi>s</mi><mi>k</mi></mrow></msub><mo separator="true">,</mo></mrow></mstyle></mtd></mtr><mtr><mtd><mstyle scriptlevel="0" displaystyle="true"><mrow><msub><mrow><mi mathvariant="normal">CVaR</mi><mo>⁡</mo></mrow><mi>α</mi></msub><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mstyle></mtd><mtd><mstyle scriptlevel="0" displaystyle="true"><mrow><mrow></mrow><mo>=</mo><munder><mrow><mi>min</mi><mo>⁡</mo></mrow><mi>ζ</mi></munder><mrow><mo fence="true">[</mo><mi>ζ</mi><mo>+</mo><mfrac><mrow><mi mathvariant="double-struck">E</mi><mo stretchy="false">(</mo><mi>L</mi><mo>−</mo><mi>ζ</mi><msub><mo stretchy="false">)</mo><mo>+</mo></msub></mrow><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow></mfrac><mo fence="true">]</mo></mrow><mo separator="true">,</mo></mrow></mstyle></mtd></mtr><mtr><mtd><mstyle scriptlevel="0" displaystyle="true"><msub><mi>r</mi><mi>k</mi></msub></mstyle></mtd><mtd><mstyle scriptlevel="0" displaystyle="true"><mrow><mrow></mrow><mo>=</mo><msub><mi>V</mi><mi>k</mi></msub><mo>−</mo><mi>γ</mi><mi mathvariant="normal">Cov</mi><mo>⁡</mo><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>k</mi></msub><mo separator="true">,</mo><msup><mi>q</mi><mi mathvariant="normal">⊤</mi></msup><mi>Y</mi><mo stretchy="false">)</mo><mo separator="true">,</mo></mrow></mstyle></mtd></mtr><mtr><mtd><mstyle scriptlevel="0" displaystyle="true"><mi>ϕ</mi></mstyle></mtd><mtd><mstyle scriptlevel="0" displaystyle="true"><mrow><mrow></mrow><mo>=</mo><mi>min</mi><mo>⁡</mo><mrow><mo fence="true">(</mo><mn>1</mn><mo separator="true">,</mo><munder><mrow><mi>min</mi><mo>⁡</mo></mrow><mi mathvariant="normal">ℓ</mi></munder><mfrac><msub><mi>D</mi><mi mathvariant="normal">ℓ</mi></msub><msub><mi>q</mi><mi mathvariant="normal">ℓ</mi></msub></mfrac><mo fence="true">)</mo></mrow><mi mathvariant="normal">.</mi></mrow></mstyle></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{aligned}V_k&amp;=\sum_{s=1}^{S}p_sA_{sk},\\ \operatorname{CVaR}_\alpha(L)&amp;=\min_\zeta\left[\zeta+\frac{\mathbb E(L-\zeta)_+}{1-\alpha}\right],\\ r_k&amp;=V_k-\gamma\operatorname{Cov}(Y_k,q^\top Y),\\ \phi&amp;=\min\left(1,\min_{\ell}\frac{D_\ell}{q_\ell}\right).\end{aligned}</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="katex-base"><span class="katex-strut" style="height:10.0546em;vertical-align:-4.7773em;"></span><span class="mord"><span class="mtable"><span class="col-align-r"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height:5.2773em;"><span style="top:-7.2773em;"><span class="pstrut" style="height:3.8283em;"></span><span class="mord"><span class="mord"><span class="mord mathnormal" style="margin-right:0.2222em;">V</span><span class="msupsub"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height:0.3361em;"><span style="top:-2.55em;margin-left:-0.2222em;margin-right:0.05em;"><span class="pstrut" style="height:2.7em;"></span><span class="katex-sizing reset-size6 size3 mtight"><span class="mord mathnormal mtight" style="margin-right:0.0315em;">k</span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height:0.15em;"><span></span></span></span></span></span></span></span></span><span style="top:-4.2602em;"><span class="pstrut" style="height:3.8283em;"></span><span class="mord"><span class="mop"><span class="mop"><span class="mord mat