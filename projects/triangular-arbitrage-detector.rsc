9:[[["$","link","css:/assets/index-CtVCEiXV.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/assets/index-CtVCEiXV.css","data-rsc-css-href":"/assets/index-CtVCEiXV.css"}],"$undefined"],["$","ol",null,{"className":"_flow_r7ckf_43","children":[["$","li","Listed-pair graph",{"children":[["$","span",null,{"children":"01"}],["$","b",null,{"children":"Listed-pair graph"}]]}],["$","li","Canonical triangles",{"children":[["$","span",null,{"children":"02"}],["$","b",null,{"children":"Canonical triangles"}]]}],["$","li","Two directions",{"children":[["$","span",null,{"children":"03"}],["$","b",null,{"children":"Two directions"}]]}],["$","li","Eligibility gates",{"children":[["$","span",null,{"children":"04"}],["$","b",null,{"children":"Eligibility gates"}]]}]]}]]
a:["$","p",null,{"children":"Conversion semantics depend on market orientation. Spending a quote asset consumes asks and divides by price; selling a base asset consumes bids and multiplies by price. The route registry stores this operation explicitly for each leg rather than inferring it from a display label at runtime. That distinction is tested with inverse-market cases because a route can have the correct three symbols and still be economically reversed. Canonicalization changes only identity and ordering, never the conversion operation."}]
b:[[["$","link","css:/assets/index-CtVCEiXV.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/assets/index-CtVCEiXV.css","data-rsc-css-href":"/assets/index-CtVCEiXV.css"}],"$undefined"],["$","section",null,{"className":"_section_r7ckf_27","id":"route-scanner","data-paper-section":true,"aria-labelledby":"route-scanner-title","children":[["$","header",null,{"className":"_sectionHead_r7ckf_28","children":[["$","span",null,{"children":"2"}],["$","div",null,{"children":[["$","h2",null,{"id":"route-scanner-title","children":"Interactive route scanner"}],["$","p",null,{"children":"Search, hub, fee, direction, state, route, amount, and playback controls operate on one deterministic tape."}]]}]]}],["$","div",null,{"className":"_sectionContent_r7ckf_32","children":[["$","p",null,{"children":"The scanner below exposes the full route universe without turning the page into a dashboard. Search selects an asset set; filters restrict hub group, direction, fee schedule, and route state. The plot and its keyboard-accessible tabs show the universe, liquidity, or a selected-route timeline. Opening the numeric disclosure gives a fixed-height text-equivalent table whose rows can be sorted and selected."}],[[["$","link","css:/assets/index-CtVCEiXV.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/assets/index-CtVCEiXV.css","data-rsc-css-href":"/assets/index-CtVCEiXV.css"}],"$undefined"],["$","figure",null,{"className":"_figure_r7ckf_40","data-interactive":"true","children":[["$","div",null,{"className":"_figureBody_r7ckf_42","children":["$","$L12",null,{"manifest":{"schemaVersion":1,"coreFingerprint":"b916e0e009b553dd1d3231f672485ef394fa1374a5b49bede14a00f6736c686a","capturedAt":"2026-08-01T00:00:00.000Z","generatedAt":"2026-08-01T17:27:04.000Z","engineCommit":"d6878178d3f461bf35b52686edaa84c2f24e7187","marketCount":803,"assetCount":342,"triangleSetCount":631,"routeCount":1262,"frameCount":60,"frameIntervalMs":1000,"marketBookCount":753,"hubBreakdown":{"KRW-BTC-X":252,"BTC-USDT-X":198,"KRW-USDT-X":180,"KRW-BTC-USDT":1},"feeBps":[0,5,10],"simulated":true,"liveMarketData":false,"liveTrading":false},"variant":"paper"}]}],["$","figcaption",null,{"children":[["$","b",null,{"children":["Figure ","1","."]}]," ","Interactive route universe and selected-route plan. Prices and books are synthetic; listing topology and deterministic artifact identity are recorded."]}]]}]],["$","p",null,{"children":"Direction selection is not cosmetic. Reversing the same asset set changes which side of each book is consumed, the intermediate denomination, and the maximum executable start amount. Fee changes are applied at every leg. The selected detail therefore reports exact leg inputs, fees, outputs, residual assets, and the route’s final net amount rather than presenting a single theoretical percentage."}]]}]]}]]
13:T3558,<span class="katex-display"><span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><msub><mi>q</mi><mi mathvariant="normal">ℓ</mi></msub><mo>=</mo><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><msub><mi>f</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">)</mo><mtext> </mtext><msub><mrow><mi mathvariant="normal">out</mi><mo>⁡</mo></mrow><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">(</mo><msub><mi>q</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow></msub><mo separator="true">;</mo><msub><mi mathvariant="script">B</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">)</mo><mo separator="true">,</mo><mspace width="1em"/><msub><mi>q</mi><mn>3</mn></msub><mo>−</mo><msub><mi>q</mi><mn>0</mn></msub><mo>=</mo><mi mathvariant="normal">Π</mi><mo stretchy="false">(</mo><msub><mi>q</mi><mn>0</mn></msub><mo stretchy="false">)</mo><mo separator="true">,</mo><mspace width="1em"/><mi>R</mi><mo>=</mo><munder><mo>∑</mo><mrow><mi>x</mi><mo mathvariant="normal">≠</mo><mi>a</mi></mrow></munder><mrow><mo fence="true">∣</mo><msubsup><mrow><mi mathvariant="normal">balance</mi><mo>⁡</mo></mrow><mi>x</mi><mrow><mi mathvariant="normal">a</mi><mi mathvariant="normal">f</mi><mi mathvariant="normal">t</mi><mi mathvariant="normal">e</mi><mi mathvariant="normal">r</mi></mrow></msubsup><mo>−</mo><msubsup><mrow><mi mathvariant="normal">balance</mi><mo>⁡</mo></mrow><mi>x</mi><mrow><mi mathvariant="normal">b</mi><mi mathvariant="normal">e</mi><mi mathvariant="normal">f</mi><mi mathvariant="normal">o</mi><mi mathvariant="normal">r</mi><mi mathvariant="normal">e</mi></mrow></msubsup><mo fence="true">∣</mo></mrow></mrow><annotation encoding="application/x-tex">q_\ell=(1-f_\ell)\,\operatorname{out}_\ell(q_{\ell-1};\mathcal B_\ell),\quad q_3-q_0=\Pi(q_0),\quad R=\sum_{x\ne a}\left|\operatorname{balance}^{\mathrm{after}}_x-\operatorname{balance}^{\mathrm{before}}_x\right|</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="katex-base"><span class="katex-strut" style="height:0.625em;vertical-align:-0.1944em;"></span><span class="mord"><span class="mord mathnormal" style="margin-right:0.0359em;">q</span><span class="msupsub"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height:0.3361em;"><span style="top:-2.55em;margin-left:-0.0359em;margin-right:0.05em;"><span class="pstrut" style="height:2.7em;"></span><span class="katex-sizing reset-size6 size3 mtight"><span class="mord mtight">ℓ</span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height:0.15em;"><span></span></span></span></span></span></span><span class="mspace" style="margin-right:0.2778em;"></span><span class="mrel">=</span><span class="mspace" style="margin-right:0.2778em;"></span></span><span class="katex-base"><span class="katex-strut" style="height:1em;vertical-align:-0.25em;"></span><span class="mopen">(</span><span class="mord">1</span><span class="mspace" style="margin-right:0.2222em;"></span><span class="mbin">−</span><span class="mspace" style="margin-right:0.2222em;"></span></span><span class="katex-base"><span class="katex-strut" style="height:1em;vertical-align:-0.25em;"></span><span class="mord"><span class="mord mathnormal" style="margin-right:0.1076em;">f</span><span class="msupsub"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height:0.3361em;"><span style="top:-2.55em;margin-left:-0.1076em;margin-right:0.05em;"><span class="pstrut" style="height:2.7em;"></span><span class="katex-sizing reset-size6 size3 mtight"><span class="mord mtight">ℓ</span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height:0.15em;"><span></span></span></span></span></span></span><span class="mclose">)</span><span class="mspace" style="margin-right:0.1667em;