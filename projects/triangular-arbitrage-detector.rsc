:"Upbit"}]]}],["$","div","Modes",{"children":[["$","dt",null,{"children":"Modes"}],["$","dd",null,{"children":"Observe · dry-run · replay"}]]}],["$","div","Evidence",{"children":[["$","dt",null,{"children":"Evidence"}],["$","dd",null,{"children":"Append-only logs"}]]}],["$","div","Live path",{"children":[["$","dt",null,{"children":"Live path"}],["$","dd",null,{"children":"Disabled by default"}]]}]]}],["$","p",null,{"className":"_keywords_r7ckf_16","children":[["$","b",null,{"children":"Keywords."}]," ","Node.js · JavaScript · Axios · WebSocket · Upbit REST/WebSocket · Node test runner"]}],["$","details",null,{"className":"_contents_r7ckf_18","id":"paper-contents","data-paper-toc":true,"children":[["$","summary",null,{"children":["Contents — ",4," sections"]}],["$","ol",null,{"children":[["$","li","universe-admissibility",{"children":["$","a",null,{"href":"#universe-admissibility","children":[["$","span",null,{"children":"1"}],"Market universe and admissibility"]}]}],["$","li","route-scanner",{"children":["$","a",null,{"href":"#route-scanner","children":[["$","span",null,{"children":"2"}],"Interactive route scanner"]}]}],["$","li","execution-plan",{"children":["$","a",null,{"href":"#execution-plan","children":[["$","span",null,{"children":"3"}],"Depth-aware execution plan"]}]}],["$","li","safety-evidence",{"children":["$","a",null,{"href":"#safety-evidence","children":[["$","span",null,{"children":"4"}],"Safety and evidence"]}]}]]}]]}]]}],["$","div",null,{"className":"_body_r7ckf_26","children":[[[["$","link","css:/assets/index-CtVCEiXV.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/assets/index-CtVCEiXV.css","data-rsc-css-href":"/assets/index-CtVCEiXV.css"}],"$undefined"],["$","section",null,{"className":"_section_r7ckf_27","id":"universe-admissibility","data-paper-section":true,"aria-labelledby":"universe-admissibility-title","children":[["$","header",null,{"className":"_sectionHead_r7ckf_28","children":[["$","span",null,{"children":"1"}],["$","div",null,{"children":[["$","h2",null,{"id":"universe-admissibility-title","children":"Market universe and admissibility"}],["$","p",null,{"children":"Topology comes from listed pairs; eligibility additionally requires fresh, connected books and a fully specified conversion path."}]]}]]}],["$","div",null,{"className":"_sectionContent_r7ckf_32","children":[["$","p",null,{"children":"A market pair is represented as a directed conversion in each executable direction. The detector joins three conversions only when their asset endpoints form a closed cycle and every edge corresponds to a listed market. Equivalent rotations are canonicalized into one asset set, then expanded into forward and reverse routes. This prevents duplicated opportunities from crowding the ranking while preserving the economically distinct directions."}],"$L7","$L8","$L9","$La"]}]]}]],"$Lb","$Lc","$Ld"]}],"$Le"]}]]}]]
