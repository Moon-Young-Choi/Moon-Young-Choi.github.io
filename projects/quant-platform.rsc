ze6 size3 mtight"><span class="mord mathnormal mtight" style="margin-right:0.0315em;">k</span></span></span><span style="top:-3.05em;"><span class="pstrut" style="height:3.05em;"></span><span><span class="mop op-symbol large-op">∑</span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height:1.3021em;"><span></span></span></span></span></span><span class="mspace" style="margin-right:0.1667em;"></span><span class="mord"><span class="mord mathnormal" style="margin-right:0.0269em;">w</span><span class="msupsub"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height:0.3361em;"><span style="top:-2.55em;margin-left:-0.0269em;margin-right:0.05em;"><span class="pstrut" style="height:2.7em;"></span><span class="katex-sizing reset-size6 size3 mtight"><span class="mord mathnormal mtight" style="margin-right:0.0315em;">k</span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height:0.15em;"><span></span></span></span></span></span></span><span class="mspace" style="margin-right:0.2778em;"></span><span class="mrel">=</span><span class="mspace" style="margin-right:0.2778em;"></span></span><span class="katex-base"><span class="katex-strut" style="height:0.6444em;"></span><span class="mord">1</span></span></span></span></span>16:[[["$","link","css:/assets/index-DStW-UAj.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/assets/index-DStW-UAj.css","data-rsc-css-href":"/assets/index-DStW-UAj.css"}],"$undefined"],["$","figure",null,{"className":"_equation_r7ckf_37","aria-label":"Entropy-pooled view and weighted log pool","children":[["$","div",null,{"children":[["$","div",null,{"className":"math-render","dangerouslySetInnerHTML":{"__html":"$27"}}],"$L28"]}],"$L29"]}]]
17:["$","p",null,{"children":"A predicted quantile Q(α)=x becomes a cumulative-probability constraint: the pooled probability of empirical scenarios satisfying g(R)≤x should be approximately α. Entropy pooling changes scenario probabilities while retaining the observed return vectors. Weighted log pooling then combines those algorithm-specific adjustments. The result is a multivariate joint distribution represented by empirical return scenarios and revised probabilities, which becomes the only forecast object passed to Portfolio Optimization."}]
18:[[["$","link","css:/assets/index-DStW-UAj.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/assets/index-DStW-UAj.css","data-rsc-css-href":"/assets/index-DStW-UAj.css"}],"$undefined"],["$","figure",null,{"className":"_figure_r7ckf_40","data-interactive":"$undefined","children":[["$","div",null,{"className":"_figureBody_r7ckf_42","children":[[["$","link","css:/assets/index-DStW-UAj.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/assets/index-DStW-UAj.css","data-rsc-css-href":"/assets/index-DStW-UAj.css"}],"$undefined"],["$","ol",null,{"className":"_flow_r7ckf_43","children":[["$","li","Four-field request",{"children":[["$","span",null,{"children":"01"}],["$","b",null,{"children":"Four-field request"}]]}],["$","li","Request-specific weights",{"children":[["$","span",null,{"children":"02"}],["$","b",null,{"children":"Request-specific weights"}]]}],["$","li","Current algorithm views",{"children":[["$","span",null,{"children":"03"}],["$","b",null,{"children":"Current algorithm views"}]]}],["$","li","Joint distribution → portfolio",{"children":[["$","span",null,{"children":"04"}],["$","b",null,{"children":"Joint distribution → portfolio"}]]}]]}]]}],["$","figcaption",null,{"children":[["$","b",null,{"children":["Figure ","2","."]}]," ","Current path. Each current algorithm executes once after request-specific weights have been calibrated; only the final portfolio crosses back to the user."]}]]}]]
1a:["$","span",null,{"children":["(","4",")"]}]
1b:["$","figcaption",null,{"children":[["$","b",null,{"children":["Historical portfolio projection and realized outcome","."]}]," ","Candidate joint scenarios and the realized outcome are evaluated through the same current portfolio. This is why the calibrated algorithm weights are portfolio-specific."]}]
1c:["$","p",null,{"children":"For every candidate algorithm-weight vector, each historical set of views is entropy-pooled against the empirical reference distribution available before τ and combined with the same weighted log-pooling rule used in the current path. The resulting asset distribution is projected through w₀. Its empirical portfolio-return distribution is compared with yτ using the continuous ranked probability score, which rewards proximity to the outcome while penalizing unnecessarily diffuse distributions."}]
2a:T4851,<span class="katex-display"><span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><mi mathvariant="normal">CRPS</mi><mo>⁡</mo><mo stretchy="false">(</mo><msub><mi>F</mi><mrow><mi>τ</mi><mo separator="true">,</mo><mi>w</mi></mrow></msub><mo separator="true">,</mo><msub><mi>y</mi><mi>τ</mi></msub><mo stretchy="false">)</mo><mo>=</mo><munder><mo>∑</mo><mi>s</mi></munder><msub><mi>q</mi><mi>s</mi></msub><mi mathvariant="normal">∣</mi><msubsup><mi>X</mi><mi>τ</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msub><mi>y</mi><mi>τ</mi></msub><mi mathvariant="normal">∣</mi><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><munder><mo>∑</mo><mi>s</mi></munder><munder><mo>∑</mo><mi>r</mi></munder><msub><mi>q</mi><mi>s</mi></msub><msub><mi>q</mi><mi>r</mi></msub><mi mathvariant="normal">∣</mi><msubsup><mi>X</mi><mi>τ</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mi>X</mi><mi>τ</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msubsup><mi mathvariant="normal">∣</mi><mo separator="true">,</mo><mspace width="2em"/><msup><mi>w</mi><mo>∗</mo></msup><mo>=</mo><mi>arg</mi><mo>⁡</mo><munder><mrow><mi>min</mi><mo>⁡</mo></mrow><mi>w</mi></munder><mfrac><mn>1</mn><mi>N</mi></mfrac><munderover><mo>∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover><mi mathvariant="normal">CRPS</mi><mo>⁡</mo><mo stretchy="false">(</mo><msub><mi>F</mi><mrow><mi>τ</mi><mo separator="true">,</mo><mi>w</mi></mrow></msub><mo separator="true">,</mo><msub><mi>y</mi><mi>τ</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\operatorname{CRPS}(F_{\tau,w},y_\tau)=\sum_s q_s|X_\tau^{(s)}-y_\tau|-\frac12\sum_s\sum_r q_sq_r|X_\tau^{(s)}-X_\tau^{(r)}|,\qquad w^*=\arg\min_w\frac1N\sum_{\tau=1}^{N}\operatorname{CRPS}(F_{\tau,w},y_\tau)</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="katex-base"><span class="katex-strut" style="height:1.0361em;vertical-align:-0.2861em;"></span><span class="mop"><span class="mord mathrm">CRPS</span></span><span class="mopen">(</span><span class="mord"><span class="mord mathnormal" style="margin-right:0.1389em;">F</span><span class="msupsub"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height:0.1514em;"><span style="top:-2.55em;margin-left:-0.1389em;margin-right:0.05em;"><span class="pstrut" style="height:2.7em;"></span><span class="katex-sizing reset-size6 size3 mtight"><span class="mord mtight"><span class="mord mathnormal mtight" style="margin-right:0.1132em;">τ</span><span class="mpunct mtight">,</span><span class="mord mathnormal mtight" style="margin-right:0.0269em;">w</span></span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height:0.2861em;"><span></span></span></span></span></span></span><span class="mpunct">,</span><span class="mspace" style="margin-right:0.1667em;"></span><span class="mord"><span class="mord mathnormal" style="margin-right:0.0359em;">y</span><span class="msupsub"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height:0.1514em;"><span style="top:-2.55em;margin-left:-0.0359em;margin-right:0.05em;"><span class="pstrut" style="height:2.7em;"></span><span class="katex-sizing reset-size6 size3 mtight"><span class="mord mathnormal mtight" style="margin-right:0.1132em;">τ</span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height:0.15em;"><span></span></span></span></span></span></span><span class="mclose">)</span><span class="mspace" style="margin-right:0.2778em;"></span><span class="mrel">=</span><span class="mspace" style="margin-right:0.2778em;"></span></span><span class="katex-base"><span class="katex-strut" style="h