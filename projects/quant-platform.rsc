e:["$","figcaption",null,{"children":[["$","b",null,{"children":["Request identity","."]}]," ","The tradable universe U, current portfolio w₀, horizon H, and Rolling Window range W jointly determine the request. Algorithm weights are recomputed for this identity and are not reused across a changed field."]}]
f:[[["$","link","css:/assets/index-DStW-UAj.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/assets/index-DStW-UAj.css","data-rsc-css-href":"/assets/index-DStW-UAj.css"}],"$undefined"],["$","figure",null,{"className":"_figure_r7ckf_40","data-interactive":"$undefined","children":[["$","div",null,{"className":"_figureBody_r7ckf_42","children":["$","div",null,{"className":"_moduleGrid_kjwnu_1","children":[["$","article","1",{"children":[["$","span",null,{"children":"01"}],["$","h3",null,{"children":"Portfolio Optimization"}],["$","p",null,{"children":"Requests one joint distribution, solves the allocation problem, and returns the optimal portfolio."}]]}],["$","article","2",{"children":[["$","span",null,{"children":"02"}],["$","h3",null,{"children":"Joint Probability Distribution"}],["$","p",null,{"children":"Combines current algorithm views with request-specific weights over an empirical reference distribution."}]]}],["$","article","3",{"children":[["$","span",null,{"children":"03"}],["$","h3",null,{"children":"Algorithm"}],["$","p",null,{"children":"Runs the same algorithms and decoders at current or historical reference times and returns probabilistic conclusions."}]]}],["$","article","4",{"children":[["$","span",null,{"children":"04"}],["$","h3",null,{"children":"Algorithm Data Collection"}],["$","p",null,{"children":"Builds algorithm-specific Evidence Bundles from FSC and DART through an Exact Data Plane and common encoder."}]]}],["$","article","5",{"children":[["$","span",null,{"children":"05"}],["$","h3",null,{"children":"Weight Optimization"}],["$","p",null,{"children":"Recomputes algorithm weights for the request by minimizing historical portfolio-distribution CRPS."}]]}],["$","article","6",{"children":[["$","span",null,{"children":"06"}],["$","h3",null,{"children":"Return Calculation"}],["$","p",null,{"children":"Applies the current weights at each historical reference time and computes the realized hold-to-horizon return."}]]}],["$","article","7",{"children":[["$","span",null,{"children":"07"}],["$","h3",null,{"children":"Optimization Data Collection"}],["$","p",null,{"children":"Supplies FSC outcome-window prices to Return Calculation and performs no prediction work."}]]}]]}]}],["$","figcaption",null,{"children":[["$","b",null,{"children":["Figure ","1","."]}]," ","The complete functional boundary. Numbers identify the seven modules fixed by the V2 specification; the user is the only external actor."]}]]}]]
10:["$","p",null,{"children":"The boundaries prevent prediction and evaluation data from collapsing into one ambiguous pipeline. Portfolio Optimization does not run algorithms or estimate their weights. Joint Probability Distribution does not walk historical windows or calculate realized portfolio returns. Algorithm does not collect raw sources, and Weight Optimization does not clone algorithm implementations. Return Calculation only creates historical outcomes for calibration; it is not an ongoing portfolio-management service."}]
11:[[["$","link","css:/assets/index-DStW-UAj.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/assets/index-DStW-UAj.css","data-rsc-css-href":"/assets/index-DStW-UAj.css"}],"$undefined"],["$","aside",null,{"className":"_note_r7ckf_48","children":[["$","b",null,{"children":"Fixed scope"}],["$","div",null,{"children":["$","p",null,{"children":"The design contains exactly seven internal modules. It does not add gateways, coordinators, workspaces, control planes, registries, caches, monitoring, audit, authentication, or deployment services. Those concepts are not implied by the functional diagram."}]}]]}]]
13:["$","span",null,{"children":["(","2",")"]}]
14:["$","figcaption",null,{"children":[["$","b",null,{"children":["Algorithm conclusion contract","."]}]," ","Every algorithm addresses the same asset universe, reference time, and holding horizon. A common view is g(R)=aᵀR, though a predefined nonlinear event may also be used."]}]
15:["$","p",null,{"children":"The reference distribution is empirical. It consists of jointly observed horizon holding-period return vectors whose outcome intervals ended before the applicable reference time. Every scenario initially receives probability 1/S. Sliding scenario starts by one observation inside the user’s Rolling Window preserves observed cross-asset co-movement and distribution shape without fitting a separate parametric law or generating new Monte Carlo returns."}]
27:T4413,<span class="katex-display"><span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><msup><mi>q</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi mathvariant="normal">EntropyPool</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>p</mi><mo separator="true">,</mo><msub><mi>C</mi><mi>k</mi></msub><mo stretchy="false">)</mo><mo separator="true">,</mo><mspace width="2em"/><msub><mi>q</mi><mi>s</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo>=</mo><mfrac><mrow><msub><mi>p</mi><mi>s</mi></msub><munder><mo>∏</mo><mi>k</mi></munder><msup><mrow><mo fence="true">(</mo><msubsup><mi>q</mi><mi>s</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mi mathvariant="normal">/</mi><msub><mi>p</mi><mi>s</mi></msub><mo fence="true">)</mo></mrow><msub><mi>w</mi><mi>k</mi></msub></msup></mrow><mrow><munder><mo>∑</mo><mi>r</mi></munder><msub><mi>p</mi><mi>r</mi></msub><munder><mo>∏</mo><mi>k</mi></munder><msup><mrow><mo fence="true">(</mo><msubsup><mi>q</mi><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mi mathvariant="normal">/</mi><msub><mi>p</mi><mi>r</mi></msub><mo fence="true">)</mo></mrow><msub><mi>w</mi><mi>k</mi></msub></msup></mrow></mfrac><mo separator="true">,</mo><mspace width="1em"/><msub><mi>w</mi><mi>k</mi></msub><mo>≥</mo><mn>0</mn><mo separator="true">,</mo><mtext> </mtext><munder><mo>∑</mo><mi>k</mi></munder><msub><mi>w</mi><mi>k</mi></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">q^{(k)}=\operatorname{EntropyPool}(p,C_k),\qquad q_s(w)=\frac{p_s\prod_k\left(q_s^{(k)}/p_s\right)^{w_k}}{\sum_r p_r\prod_k\left(q_r^{(k)}/p_r\right)^{w_k}},\quad w_k\ge0,\ \sum_k w_k=1</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="katex-base"><span class="katex-strut" style