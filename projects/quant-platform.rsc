1e:["$","p",null,{"children":"Candidate weights lie on a nonnegative simplex grid with initial spacing δ=0.1. Two algorithms produce eleven candidates from (0,1) through (1,0); additional algorithms use every 0.1-spaced combination whose components sum to one. This is an exhaustive functional rule, not a claim about a later numerical implementation. The selected weights return to Joint Probability Distribution and are then used for the current views."}]
1f:[[["$","link","css:/assets/index-DStW-UAj.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/assets/index-DStW-UAj.css","data-rsc-css-href":"/assets/index-DStW-UAj.css"}],"$undefined"],["$","figure",null,{"className":"_figure_r7ckf_40","data-interactive":"$undefined","children":[["$","div",null,{"className":"_figureBody_r7ckf_42","children":["$","div",null,{"className":"_laneFigure_kjwnu_36","children":[["$","div",null,{"children":[["$","span",null,{"children":"Prediction lane"}],["$","b",null,{"children":"FSC + DART"}],["$","i",null,{"children":"Algorithm Data Collection"}],["$","strong",null,{"children":"Evidence Bundle → same Algorithm"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Outcome lane"}],["$","b",null,{"children":"FSC only"}],["$","i",null,{"children":"Optimization Data Collection"}],["$","strong",null,{"children":"Prices → Return Calculation"}]]}],["$","p",null,{"children":"Historical views + realized current-portfolio return → candidate pools → mean CRPS → request-specific weights"}]]}]}],["$","figcaption",null,{"children":[["$","b",null,{"children":["Figure ","3","."]}]," ","Historical calibration. Forecast evidence and outcome prices share FSC as a source but remain in separate modules because their meanings and consumers differ."]}]]}]]
21:["$","span",null,{"children":["(","6",")"]}]
22:["$","figcaption",null,{"children":[["$","b",null,{"children":["Final portfolio objective","."]}]," ","CVaR level α, risk coefficient λ, change coefficient κ, asset bounds, and shorting or leverage permissions remain request or preset parameters; the specification does not assign arbitrary values."]}]
23:["$","p",null,{"children":"The V2 design is functionally and mathematically complete at this level. It fixes the module list and responsibilities, current and historical reuse of algorithms, empirical reference distribution, probabilistic conclusion contract, entropy pooling, weighted log pooling, simplex search, CRPS evaluation, Rolling Window behavior, realized-return definition, and final allocation objective. The current reference time is the request time; historical reference times move through the selected window."}]
24:["$","p",null,{"children":"Several details are intentionally outside the specification rather than unfinished architecture decisions. The user chooses the forecast horizon and Rolling Window. Common quantile levels, CVaR level, λ, κ, asset-weight bounds, and short or leverage permissions are request-level or preset parameters. Concrete message fields, APIs, serialization, encoder and decoder implementation, runtime technology, and deployment topology are excluded. No parameter value should be inferred from the diagrams on this page."}]
