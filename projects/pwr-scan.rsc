6d:["$","li","appendix-b-9",{"id":"appendix-b-9","children":[["$","p",null,{"children":[["$","a",null,{"href":"#appendix-b-9","children":["B.9","."]}]," ",["$","strong",null,{"children":["Monte Carlo randomization power loss","."]}]," ","Conditional exceedances are binomial. A Chernoff bound gives R of order alpha^{-1} log(2/beta), not M/alpha."]}],["$","small",null,{"children":["Linked objects: ",[["$","span","proposition-5-10",{"children":[false,["$","a",null,{"href":"#proposition-5-10","children":"Proposition 5.10"}]]}]]]}]]}]
