94:["$","p",null,{"className":"_proofText_1t4cy_273","children":[["$","em",null,{"children":"Proof."}]," ","Treat the already-maximized scan as one measurable statistic. Apply Lemma 5.4 to its orbit rank. No blockwise union bound is needed because maximization is inside S."," ",["$","span",null,{"aria-hidden":"true","children":"□"}]]}]
95:["$","p",null,{"className":"_resolution_1t4cy_275","children":[["$","em",null,{"children":"Consequently."}]," ","The global test is finite-sample level alpha under the explicit exchangeability null."," ",["$","span",null,{"children":[["$","em",null,{"children":"Scope."}]," ","Exactness does not extend automatically to unequal full laws with equal covariance."]}]]}]
97:["$","figcaption",null,{"children":[["$","a",null,{"href":"#eq-5-16","children":"(5.16)"}],["$","span",null,{"className":"_screenReaderOnly_1t4cy_269","children":"under the exchangeability null, the probability that the Monte Carlo p-value is at most alpha is at most alpha"}]]}]
98:["$","p",null,{"className":"_proofText_1t4cy_273","children":[["$","em",null,{"children":"Proof."}]," ","Introduce an independent uniform reference group element G0. Conditional on the orbit, the R + 1 transformed statistics are exchangeable. The conservative upper rank of the reference statistic is super-uniform; relative transformations recover the implemented p-value law."," ",["$","span",null,{"aria-hidden":"true","children":"□"}]]}]
99:["$","p",null,{"className":"_resolution_1t4cy_275","children":[["$","em",null,{"children":"Consequently."}]," ","Monte Carlo randomization retains finite-sample validity for every R."," ",["$","span",null,{"children":[["$","em",null,{"children":"Scope."}]," ","Validity can coexist with no rejection resolution when R + 1 < 1/alpha."]}]]}]
9c:["$","figcaption",null,{"children":[["$","a",null,{"href":"#eq-5-20","children":"(5.20)"}],["$","span",null,{"className":"_screenReaderOnly_1t4cy_269","children":"Monte Carlo power is at least one minus beta minus an explicit binomial tail"}]]}]
9d:["$","p",null,{"className":"_proofText_1t4cy_273","children":[["$","em",null,{"children":"Proof."}]," ","Conditional on data, the exceedance count is Binomial(R,p(D)). On p(D) <= gamma it is stochastically dominated by Binomial(R,gamma). Union-bound failure of the full-orbit margin and the binomial resolution event."," ",["$","span",null,{"aria-hidden":"true","children":"□"}]]}]
9e:["$","p",null,{"className":"_resolution_1t4cy_275","children":[["$","em",null,{"children":"Consequently."}]," ","R can be selected from a target additional power loss, not by an informal 'large enough' rule."," ",["$","span",null,{"children":[["$","em",null,{"children":"Scope."}]," ","The proposition transfers an established full-orbit margin; it does not create that margin."]}]]}]
a0:["$","figcaption",null,{"children":[["$","a",null,{"href":"#eq-6-4","children":"(6.4)"}],["$","span",null,{"className":"_screenReaderOnly_1t4cy_269","children":"block size plus entropy plus tail parameter is at most c zero times effective sample size"}]]}]
a1:["$","p",null,{"className":"_resolution_1t4cy_275","children":[["$","em",null,{"children":"Interpretation."}]," ","Second-order covariance concentration remains controlled uniformly over the candidate family."," ",["$","span",null,{"children":[["$","em",null,{"children":"Scope."}]," ","The proportional b/n regime requires separate random-matrix asymptotics and is not covered."]}]]}]
a3:["$","figcaption",null,{"children":[["$","a",null,{"href":"#eq-6-7","children":"(6.7)"}],["$","span",null,{"className":"_screenReaderOnly_1t4cy_269","children":"the observed root is below the population root minus its concentration radius with probability at most two e to minus t"}]]}]
a4:["$","p",null,{"className":"_proofText_1t4cy_273","children":[["$","em",null,{"children":"Proof."}]," ","Move to population pooled coordinates. Concentrate both group covariance errors in operator norm. Control inverse-square-root perturbation of the sample whitener. Apply Weyl's inequality to the largest eigenvalue."," ",["$","span",null,{"aria-hidden":"true","children":"□"}]]}]
a5:["$","p",null,{"className":"_resolution_1t4cy_275","children":[["$","em",null,{"children":"Consequently."}]," ","The true block score has an explicit high-probability signal lower bound."," ",["$","span",null,{"children":[["$","em",null,{"children":"Scope."}]," ","Constants rely on Gaussianity, group balance and bounded relative covariance."]}]]}]
a7:["$","figcaption",null,{"children":[["$","a",null,{"href":"#eq-6-10","children":"(6.10)"}],["$","span",null,{"className":"_screenReaderOnly_1t4cy_269","children":"the joint probability that the randomized scan exceeds C two kappa t is at most two e to minus t"}]]}]
a8:["$","p",null,{"className":"_proofText_1t4cy_273","children":[["$","em",null,{"children":"Proof."}]," ","Express the permuted covariance difference exactly as a centered finite-population matrix sum. Control hypergeometric imbalance of original group membership. Condition on the assignment and concentrate non-identically distributed Gaussian quadratic forms over a net. Transfer population to sample pooled whitening and use the weighted union bound over overlapping blocks."," ",["$","span",null,{"aria-hidden":"true","children":"□"}]]}]
a9:["$","p",null,{"className":"_resolution_1t4cy_275","children":[["$","em",null,{"children":"Consequently."}]," ","Random partition erases the O(tau) signal up to hypergeometric leakage and matrix fluctuation on the same a_B scale."," ",["$","span",null,{"children":[["$","em",null,{"children":"Scope."}]," ","The lemma is a joint data-permutation tail, not a pointwise deterministic bound for every conditional permutation quantile."]}]]}]
ab:["$","figcaption",null,{"children":[["$","a",null,{"href":"#eq-6-20","children":"(6.20)"}],["$","span",null,{"className":"_screenReaderOnly_1t4cy_269","children":"the signal is at least a constant times the square root dimension rate plus square root entropy rate"}]]}]
ac:["$","p",null,{"className":"_resolution_1t4cy_275","children":[["$","em",null,{"children":"Interpretation."}]," ","A sufficiently large constant times sqrt(b/n_e) + sqrt(ell/n_e) yields power at least 1 - beta."," ",["$","span",null,{"children":[["$","em",null,{"children":"Scope."}]," ","This is a rate statement; it does not supply a sharp finite-sample constant."]}]]}]
ae:["$","figcaption",null,{"children":[["$","a",null,{"href":"#eq-6-31","children":"(6.31)-(6.32)"}],["$","span",null,{"className":"_screenReaderOnly_1t4cy_269","children":"effective signal is the positive part of tau minus eta and yields power at least one minus beta under the separation condition"}]]}]
af:["$","p",null,{"className":"_proofText_1t4cy_273","children":[["$","em",null,{"children":"Proof."}]," ","Weyl's inequality lower-bounds the population leading eigenvalue by tau - eta. All subsequent concentration and random-partition arguments use only that population lower bound."," ",["$","span",null,{"aria-hidden":"true","children":"□"}]]}]
b0:["$","p",null,{"className":"_resolution_1t4cy_275","children":[["$","em",null,{"children":"Consequently."}]," ","The finite-sample power guarantee degrades explicitly with operator-norm mismatch."," ",["$","span",null,{"children":[["$","em",null,{"children":"Scope."}]," ","When eta >= tau the theorem guarantees no positive signal and no favorable power claim is justified."]}]]}]
b2:["$","figcaption",null,{"children":[["$","a",null,{"href":"#eq-7-17","children":"(7.17)"}],["$","span",null,{"className":"_screenReaderOnly_1t4cy_269","children":"the pooled leading root on the covering block is at least the leading root on the true interval"}]]}]
b3:["$","p",null,{"className":"_proofText_1t4cy_273","children":[["$","em",null,{"children":"Proof."}]," ","Write the leading root as a generalized Rayleigh maximum on B. Restrict candidate vectors to zero outside I. On this subset, numerator and denominator equal the I-block Rayleigh quotient."," ",["$","span",null,{"aria-hidden":"true","children":"□"}]]}]
b4:["$","p",null,{"className":"_resolution_1t4cy_275","children":[["$","em",null,{"children":"Consequently."}]," ","Covering enlarges noise dimension but does not attenuate a strict PSD block signal."," ",["$","span",null,{"children":[["$","em",null,{"children":"Scope."}]," ","An indefinite remainder must be handled separately through the eta mismatch bound."]}]]}]
b6:["$","figcaption",null,{"children":[["$","a",null,{"href":"#eq-7-22","children":"(7.21)-(7.22)"}],["$","span",null,{"className":"_screenReaderOnly_1t4cy_269","children":"adaptive radius equals direction, adaptive entropy, and second-order terms; signal above a constant times this radius is detected"}]]}]
b7:["$","p",null,{"className":"_proofText_1t4cy_273","children":[["$","em",null,{"children":"Proof."}]," ","Select the constant-factor covering block from Theorem 7.1. Use Lemma 7.2 to preserve the population effect. Bound covering-block dimension and its weighted entropy by b and Lambda_b. Insert those bounds into Theorem 6.6 and absorb constants."," ",["$","span",null,{"aria-hidden":"true","children":"□"}]]}]
b8:["$","p",null,{"className":"_resolution_1t4cy_275","children":[["$","em",null,{"children":"Consequently."}]," ","One permutation-calibrated multiscale maximum adapts over unknown interval width."," ",["$","span",null,{"children":[["$","em",null,{"children":"Scope."}]," ","The theorem is an adaptive upper bound and does not prove that its log-log scale cost is information-theoretically necessary."]}]]}]
ba:["$","figcaption",null,{"children":[["$","a",null,{"href":"#eq-7-25","children":"(7.25)"}],["$","span",null,{"className":"_screenReaderOnly_1t4cy_269","children":"the adaptive rate is square root b over n plus the square root of location entropy and twice log scale count over n"}]]}]
bb:["$","p",null,{"className":"_resolution_1t4cy_275","children":[["$","em",null,{"children":"Interpretation."}]," ","Width adaptation costs at most a logarithm of the number of scales inside the square-root entropy term."," ",["$","span",null,{"children":[["$","em",null,{"children":"Scope."}]," ","Removal or necessity of the adaptation term is an unresolved sharp-adaptation question."]}]]}]
bd:["$","figcaption",null,{"children":[["$","a",null,{"href":"#eq-b-4","children":"(B.4)"}],["$","span",null,{"className":"_screenReaderOnly_1t4cy_269","children":"sample covariance error is at most two r plus r squared"}]]}]
be:["$","p",null,{"className":"_proofText_1t4cy_273","children":[["$","em",null,{"children":"Proof."}]," ","Represent the covariance as m^{-1}G^T G. Apply the extreme singular-value inequality to G. Square the normalized singular-value interval and take its largest deviation from one."," ",["$","span",null,{"aria-hidden":"true","children":"□"}]]}]
