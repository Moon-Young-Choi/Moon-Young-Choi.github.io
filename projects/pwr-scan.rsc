74:["$","div",null,{"className":"_foundationNote_1t4cy_467","children":[["$","h3",null,{"children":"Appendix A · foundational toolkit"}],["$","ol",null,{"children":[["$","li","foundation-a-1",{"id":"foundation-a-1","children":[["$","a",null,{"href":"#foundation-a-1","children":["A.1","."]}]," ",["$","strong",null,{"children":["Vectors, outer products and covariance","."]}]," ","Defines the second-moment objects and rank-one matrix notation used by the acoustic bridge."]}],["$","li","foundation-a-2",{"id":"foundation-a-2","children":[["$","a",null,{"href":"#foundation-a-2","children":["A.2","."]}]," ",["$","strong",null,{"children":["PSD order, positive definiteness and operator norm","."]}]," ","Fixes the matrix order and worst-direction error metric used for mismatch bounds."]}],["$","li","foundation-a-3",{"id":"foundation-a-3","children":[["$","a",null,{"href":"#foundation-a-3","children":["A.3","."]}]," ",["$","strong",null,{"children":["Eigenvalues and Rayleigh-Ritz","."]}]," ","Turns directional covariance growth into a maximum quadratic quotient."]}],["$","li","foundation-a-4",{"id":"foundation-a-4","children":[["$","a",null,{"href":"#foundation-a-4","children":["A.4","."]}]," ",["$","strong",null,{"children":["Whitening and congruence","."]}]," ","Explains coordinate-free comparison of covariance matrices and preservation of generalized roots."]}],["$","li","foundation-a-5",{"id":"foundation-a-5","children":[["$","a",null,{"href":"#foundation-a-5","children":["A.5","."]}]," ",["$","strong",null,{"children":["Generalized eigenvalues and the pooled-whitened root","."]}]," ","Connects the PWR statistic to the Fisher-Roy generalized eigenvalue problem."]}],["$","li","foundation-a-6",{"id":"foundation-a-6","children":[["$","a",null,{"href":"#foundation-a-6","children":["A.6","."]}]," ",["$","strong",null,{"children":["Wishart, Jacobi ensemble and finite-sample root CDF","."]}]," ","Locates exact Gaussian root laws as a reference calculation, not the operational global calibration."]}],["$","li","foundation-a-7",{"id":"foundation-a-7","children":[["$","a",null,{"href":"#foundation-a-7","children":["A.7","."]}]," ",["$","strong",null,{"children":["Role and limit of the Tracy-Widom law","."]}]," ","Separates proportional-dimensional asymptotics from the manuscript's moderate-dimensional permutation theorem."]}],["$","li","foundation-a-8",{"id":"foundation-a-8","children":[["$","a",null,{"href":"#foundation-a-8","children":["A.8","."]}]," ",["$","strong",null,{"children":["Multiple weak spikes and linear spectral statistics","."]}]," ","Marks an alternative regime not covered by a largest-root directional test."]}],["$","li","foundation-a-9",{"id":"foundation-a-9","children":[["$","a",null,{"href":"#foundation-a-9","children":["A.9","."]}]," ",["$","strong",null,{"children":["Sample covariance and centering","."]}]," ","Makes denominator, degrees-of-freedom and label-dependent preprocessing choices explicit."]}],["$","li","foundation-a-10",{"id":"foundation-a-10","children":[["$","a",null,{"href":"#foundation-a-10","children":["A.10","."]}]," ",["$","strong",null,{"children":["Permutation groups and randomization p-values","."]}]," ","Provides the finite-group orbit language behind exact and Monte Carlo ranks."]}],["$","li","foundation-a-11",{"id":"foundation-a-11","children":[["$","a",null,{"href":"#foundation-a-11","children":["A.11","."]}]," ",["$","strong",null,{"children":["Sub-Gaussian and sub-exponential variables","."]}]," ","Supplies tail classes for Gaussian quadratic-form concentration."]}],["$","li","foundation-a-12",{"id":"foundation-a-12","children":[["$","a",null,{"href":"#foundation-a-12","children":["A.12","."]}]," ",["$","strong",null,{"children":["Epsilon nets and direction-search cost","."]}]," ","Explains why maximizing an unknown b-dimensional direction contributes the square-root b over n term."]}],["$","li","foundation-a-13",{"id":"foundation-a-13","children":[["$","a",null,{"href":"#foundation-a-13","children":["A.13","."]}]," ",["$","strong",null,{"children":["Minimax risk and separation rate","."]}]," ","Defines the lower-bound decision criterion and rate comparison."]}],["$","li","foundation-a-14",{"id":"foundation-a-14","children":["$Lc8"," ","$Lc9"," ","Relates separate spherical and block-location mixtures to the matched two-term rate."]}],"$Lca"]}]]}]
77:["$","figcaption",null,{"children":[["$","a",null,{"href":"#eq-2-13","children":"(2.13)-(2.14)"}],["$","span",null,{"className":"_screenReaderOnly_1t4cy_269","children":"covariance difference equals a rank-one term plus an operator-norm-bounded remainder"}]]}]
78:["$","p",null,{"className":"_proofText_1t4cy_273","children":[["$","em",null,{"children":"Proof."}]," ","Expand g(U) at u0 and center the Taylor remainder. Use E[xi | U] = 0 to remove residual cross-covariances. Bound E[V r-bar], Cov(r-bar), and rank-one cross terms by Cauchy-Schwarz and the operator norm identity for outer products."," ",["$","span",null,{"aria-hidden":"true","children":"□"}]]}]
79:["$","p",null,{"className":"_resolution_1t4cy_275","children":[["$","em",null,{"children":"Consequently."}]," ","The acoustic model supplies a quantified rank-one leading covariance term rather than an exact factor claim."," ",["$","span",null,{"children":[["$","em",null,{"children":"Scope."}]," ","If the remainder bound is of the same order as tau^2 ||ell||^2, a rank-one interpretation is not warranted."]}]]}]
7b:["$","figcaption",null,{"children":[["$","a",null,{"href":"#eq-2-31","children":"(2.31)"}],["$","span",null,{"className":"_screenReaderOnly_1t4cy_269","children":"when vartheta is greater than eta, the pooled effect is bounded below by vartheta minus eta divided by one plus pi one times vartheta minus eta, which is positive"}]]}]
7c:["$","p",null,{"className":"_proofText_1t4cy_273","children":[["$","em",null,{"children":"Proof."}]," ","Insert u into the Rayleigh quotient. Apply |u^T E_B u| <= ||E_B||op. Use monotonicity of x/(1 + pi_1 x) to translate the baseline-relative gap into the pooled-whitened effect."," ",["$","span",null,{"aria-hidden":"true","children":"□"}]]}]
7d:["$","p",null,{"className":"_resolution_1t4cy_275","children":[["$","em",null,{"children":"Consequently."}]," ","The conservative effective signal is (vartheta - eta)+, mapped monotonically to the pooled parameter."," ",["$","span",null,{"children":[["$","em",null,{"children":"Scope."}]," ","The result supplies no positive-signal guarantee when eta >= vartheta."]}]]}]
7f:["$","figcaption",null,{"children":[["$","a",null,{"href":"#eq-3-15","children":"(3.15)"}],["$","span",null,{"className":"_screenReaderOnly_1t4cy_269","children":"null rejection probability is at most alpha plus N minus one times beta of the guard gap"}]]}]
80:["$","p",null,{"className":"_proofText_1t4cy_273","children":[["$","em",null,{"children":"Proof."}]," ","Couple clusters sequentially to independent replicas. A union bound limits any coupling mismatch to (N - 1) beta(g). On the no-mismatch event, the dependent-data decision equals the exact independent-copy decision."," ",["$","span",null,{"aria-hidden":"true","children":"□"}]]}]
81:["$","p",null,{"className":"_resolution_1t4cy_275","children":[["$","em",null,{"children":"Consequently."}]," ","Dependence costs an explicit additive level error."," ",["$","span",null,{"children":[["$","em",null,{"children":"Scope."}]," ","A visually small sample autocorrelation is not evidence that beta(g) equals zero."]}]]}]
83:["$","figcaption",null,{"children":[["$","a",null,{"href":"#eq-4-11","children":"(4.11)-(4.12)"}],["$","span",null,{"className":"_screenReaderOnly_1t4cy_269","children":"each PWR eigenvalue is a monotone transform of its generalized eigenvalue and T B is h of Roy's root"}]]}]
84:["$","p",null,{"className":"_proofText_1t4cy_273","children":[["$","em",null,{"children":"Proof."}]," ","Use the same generalized eigenvector for the difference/pooled pair. Symmetric whitening preserves generalized eigenvalues. Differentiate h to obtain a strictly positive derivative."," ",["$","span",null,{"aria-hidden":"true","children":"□"}]]}]
85:["$","p",null,{"className":"_resolution_1t4cy_275","children":[["$","em",null,{"children":"Consequently."}]," ","Within a block, PWR and Fisher-Roy orderings and one-sided rejection regions coincide exactly."," ",["$","span",null,{"children":[["$","em",null,{"children":"Scope."}]," ","The pooled representation is a reparameterization, not a claim of a new empirical root."]}]]}]
87:["$","figcaption",null,{"children":[["$","a",null,{"href":"#eq-4-15","children":"(4.15)"}],["$","span",null,{"className":"_screenReaderOnly_1t4cy_269","children":"a B equals the square root direction term plus square root weighted search term plus a second-order term"}]]}]
88:["$","p",null,{"className":"_resolution_1t4cy_275","children":[["$","em",null,{"children":"Interpretation."}]," ","Different block widths become comparable on a common theoretical noise scale."," ",["$","span",null,{"children":[["$","em",null,{"children":"Scope."}]," ","Weights are complexity allocations, not posterior signal probabilities, and cannot be tuned after viewing the test data."]}]]}]
8a:["$","figcaption",null,{"children":[["$","a",null,{"href":"#eq-4-17","children":"(4.17)"}],["$","span",null,{"className":"_screenReaderOnly_1t4cy_269","children":"Z B is T B divided by a B and S PWR is the maximum Z B"}]]}]
8b:["$","p",null,{"className":"_resolution_1t4cy_275","children":[["$","em",null,{"children":"Interpretation."}]," ","The method performs one global upper-tail rank calculation per analysis."," ",["$","span",null,{"children":[["$","em",null,{"children":"Scope."}]," ","Data-dependent candidate additions must be repeated inside every permutation or treated as a new procedure."]}]]}]
8d:["$","figcaption",null,{"children":[["$","a",null,{"href":"#eq-5-8","children":"(5.8)"}],["$","span",null,{"className":"_screenReaderOnly_1t4cy_269","children":"the PWR p-value is the orbit fraction with statistic at least the observed statistic"}]]}]
8e:["$","p",null,{"className":"_resolution_1t4cy_275","children":[["$","em",null,{"children":"Interpretation."}]," ","Reject at level alpha exactly when the orbit p-value is at most alpha."," ",["$","span",null,{"children":[["$","em",null,{"children":"Scope."}]," ","The p-value grid cannot resolve values below one over the orbit size."]}]]}]
90:["$","span",null,{"aria-hidden":"true","children":"□"}]
91:["$","p",null,{"className":"_resolution_1t4cy_275","children":[["$","em",null,{"children":"Consequently."}]," ","P(p_S <= u) <= u for every u in [0,1]."," ",["$","span",null,{"children":[["$","em",null,{"children":"Scope."}]," ","The lemma proves validity, not power or sharpness of the random critical value."]}]]}]
