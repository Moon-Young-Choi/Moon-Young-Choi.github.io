56:["$","article","corollary-6-10",{"className":"_proofCard_1t4cy_227","id":"corollary-6-10","data-kind":"corollary","children":[["$","header",null,{"children":[["$","h3",null,{"children":[["$","a",null,{"href":"#corollary-6-10","children":["Corollary 6.10","."]}]," ","Finite Monte Carlo power"]}],["$","span",null,{"children":"corollary"}]]}],["$","p",null,{"className":"_statement_1t4cy_249","children":"Replacing alpha by a strict margin gamma in Theorem 6.6 and applying Proposition 5.10 yields full finite-sample Monte Carlo power minus an explicit binomial tail."}],["$","p",null,{"className":"_prerequisites_1t4cy_251","children":[["$","strong",null,{"children":"Uses."}]," ",[["$","span","Orbit resolution below gamma",{"children":[false,"Orbit resolution below gamma"]}],["$","span","Theorem 6.6 separation at the gamma margin",{"children":[" · ","Theorem 6.6 separation at the gamma margin"]}],["$","span","theorem-6-6",{"children":[" · ",["$","a",null,{"href":"#theorem-6-6","children":"Theorem 6.6"}]]}],["$","span","proposition-5-10",{"children":[" · ",["$","a",null,{"href":"#proposition-5-10","children":"Proposition 5.10"}]]}]]]}],[],false,["$","p",null,{"className":"_resolution_1t4cy_275","children":[["$","em",null,{"children":"Interpretation."}]," ","The permutation budget R can be tied to a stated power-loss tolerance."," ",["$","span",null,{"children":[["$","em",null,{"children":"Scope."}]," ","The locked V2 campaign needed to estimate operational constants remains pending."]}]]}]]}]
58:["$","figcaption",null,{"children":[["$","a",null,{"href":"#eq-6-25","children":"(6.25)-(6.26)"}],["$","span",null,{"className":"_screenReaderOnly_1t4cy_269","children":"below the maximum of direction and location rates, minimax total risk stays at least c zero"}]]}]
59:["$","p",null,{"className":"_proofText_1t4cy_273","children":[["$","em",null,{"children":"Proof."}]," ","Unknown direction: mix the spike direction uniformly on the b-sphere and bound chi-square divergence when n theta^2/b is small. Unknown location: mix fixed orthogonal directions over M disjoint blocks and bound divergence when n theta^2 <= c log M. Use Le Cam's inequality in each subexperiment and take the harder of the two costs."," ",["$","span",null,{"aria-hidden":"true","children":"□"}]]}]
5a:["$","p",null,{"className":"_resolution_1t4cy_275","children":[["$","em",null,{"children":"Consequently."}]," ","No test uniformly beats both the direction and location square-root costs."," ",["$","span",null,{"children":[["$","em",null,{"children":"Scope."}]," ","The theorem is a rate lower bound with universal constants, not a sharp power envelope."]}]]}]
5c:["$","figcaption",null,{"children":[["$","a",null,{"href":"#eq-6-29","children":"(6.29)"}],["$","span",null,{"className":"_screenReaderOnly_1t4cy_269","children":"the minimax separation rate is square root b over n plus square root log M over n"}]]}]
5d:["$","p",null,{"className":"_proofText_1t4cy_273","children":[["$","em",null,{"children":"Proof."}]," ","Balance makes n_e, n and n_1 equivalent up to constants. The monotone pooled effect is equivalent to the bounded baseline spike. Corollary 6.9 supplies the upper rate; Theorem 6.11 supplies max of the same two terms. Use max{x,y} <= x+y <= 2 max{x,y}."," ",["$","span",null,{"aria-hidden":"true","children":"□"}]]}]
5e:["$","p",null,{"className":"_resolution_1t4cy_275","children":[["$","em",null,{"children":"Consequently."}]," ","The same permutation-calibrated statistic that is exact under the null is rate-optimal in the Gaussian reference experiment."," ",["$","span",null,{"children":[["$","em",null,{"children":"Scope."}]," ","No uniformly most-powerful, sharp-constant, proportional-dimensional or non-Gaussian optimality claim is made."]}]]}]
5f:["$","article","remark-6-13",{"className":"_proofCard_1t4cy_227","id":"remark-6-13","data-kind":"remark","children":[["$","header",null,{"children":[["$","h3",null,{"children":[["$","a",null,{"href":"#remark-6-13","children":["Remark 6.13","."]}]," ","What rate optimality does not say"]}],["$","span",null,{"children":"remark"}]]}],["$","p",null,{"className":"_statement_1t4cy_249","children":"Theorem 6.12 establishes order and fixed-factor equivalence only; it does not imply uniform most-powerfulness, a sharp asymptotic constant, a power envelope, or optimality beyond independent balanced Gaussian moderate dimension."}],["$","p",null,{"className":"_prerequisites_1t4cy_251","children":[["$","strong",null,{"children":"Uses."}]," ",[["$","span","theorem-6-12",{"children":[false,["$","a",null,{"href":"#theorem-6-12","children":"Theorem 6.12"}]]}]]]}],[],false,["$","p",null,{"className":"_resolution_1t4cy_275","children":[["$","em",null,{"children":"Interpretation."}]," ","The public claim is deliberately narrower than 'optimal in all settings'."," ",["$","span",null,{"children":[["$","em",null,{"children":"Scope."}]," ","Real-audio performance and external validity require empirical evidence, not extrapolation from this theorem."]}]]}]]}]
61:["$","figcaption",null,{"children":[["$","a",null,{"href":"#eq-6-30","children":"(6.30)"}],["$","span",null,{"className":"_screenReaderOnly_1t4cy_269","children":"the population contrast equals a rank-one signal plus an operator norm bounded remainder"}]]}]
62:["$","p",null,{"className":"_resolution_1t4cy_275","children":[["$","em",null,{"children":"Interpretation."}]," ","Model mismatch enters the power theorem through a single conservative signal erosion eta."," ",["$","span",null,{"children":[["$","em",null,{"children":"Scope."}]," ","Eta must be bounded externally; describing leakage as merely 'small' is not sufficient."]}]]}]
