1:[[["$","link","css:/assets/index-CtVCEiXV.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/assets/index-CtVCEiXV.css","data-rsc-css-href":"/assets/index-CtVCEiXV.css"}],"$undefined"],["$","main",null,{"className":"_page_r7ckf_1","style":{"--paper-accent":"var(--ink)"},"children":[["$","header",null,{"className":"site-header _nav_r7ckf_2","children":[["$","$L6",null,{"className":"wordmark","href":"/","children":"MYC / 26"}],["$","nav",null,{"aria-label":"PWR-Scan paper navigation","children":[["$","a",null,{"href":"#paper-contents","children":"Contents"}],["$","a",null,{"href":"#references","children":"References"}]]}],["$","$L6",null,{"className":"header-link","href":"/#projects","children":"Close ×"}]]}],["$","article",null,{"className":"_paper_r7ckf_3","children":[["$","header",null,{"className":"_masthead_r7ckf_4","data-paper-header":true,"children":[["$","div",null,{"className":"_runningHead_r7ckf_5","children":[["$","span",null,{"children":["Project ","02"]}],["$","span",null,{"children":"Pooled-Whitened Randomization Scan"}],["$","span",null,{"children":"Proof-led statistical system"}]]}],["$","h1",null,{"children":"PWR-Scan"}],["$","div",null,{"className":"_abstract_r7ckf_7","children":[["$","b",null,{"children":"Abstract."}],["$","p",null,{"children":"PWR-Scan tests for a localized positive covariance change when both its frequency interval and leading direction are unknown. It combines pooled whitening with a block scan and an exact randomization calibration, then separates finite-sample validity, asymptotic detection theory, implementation checks, synthetic exploration, and external-data evidence so that one evidence class is never presented as another."}]]}],["$","dl",null,{"className":"_metadata_r7ckf_10","children":[["$","div","Theory",{"children":[["$","dt",null,{"children":"Theory"}],["$","dd",null,{"children":"Finite-sample and minimax manuscript"}]]}],["$","div","Engineering",{"children":[["$","dt",null,{"children":"Engineering"}],["$","dd",null,{"children":"v0.2.2 closeout complete"}]]}],["$","div","Publication validation",{"children":[["$","dt",null,{"children":"Publication validation"}],["$","dd",null,{"children":"Pending"}]]}],["$","div","External validity",{"children":[["$","dt",null,{"children":"External validity"}],["$","dd",null,{"children":"Not established"}]]}]]}],["$","p",null,{"className":"_keywords_r7ckf_16","children":[["$","b",null,{"children":"Keywords."}]," ","Python · NumPy · SciPy · FastAPI · pytest · pandas · deterministic oracle · Exact orbits · Monte Carlo randomization · SHA-256 provenance"]}],["$","details",null,{"className":"_contents_r7ckf_18","id":"paper-contents","data-paper-toc":true,"children":[["$","summary",null,{"children":["Contents — ",4," sections"]}],["$","ol",null,{"children":[["$","li","problem-statistic",{"children":["$","a",null,{"href":"#problem-statistic","children":[["$","span",null,{"children":"1"}],"Problem and statistic"]}]}],["$","li","finite-validity",{"children":["$","a",null,{"href":"#finite-validity","children":[["$","span",null,{"children":"2"}],"Finite-sample validity"]}]}],["$","li","minimax-rate",{"children":["$","a",null,{"href":"#minimax-rate","children":[["$","span",null,{"children":"3"}],"Minimax rate and adaptation"]}]}],["$","li","implementation-evidence",{"children":["$","a",null,{"href":"#implementation-evidence","children":[["$","span",null,{"children":"4"}],"Implementation and empirical evidence"]}]}]]}]]}]]}],["$","div",null,{"className":"_body_r7ckf_26","children":[[[["$","link","css:/assets/index-CtVCEiXV.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/assets/index-CtVCEiXV.css","data-rsc-css-href":"/assets/index-CtVCEiXV.css"}],"$undefined"],["$","section",null,{"className":"_section_r7ckf_27","id":"problem-statistic","data-paper-section":true,"aria-labelledby":"problem-statistic-title","children":[["$","header",null,{"className":"_sectionHead_r7ckf_28","children":[["$","span",null,{"children":"1"}],["$","div",null,{"children":[["$","h2",null,{"id":"problem-statistic-title","children":"Problem and statistic"}],["$","p",null,{"children":"The inferential unit is the complete recording; the target is a positive covariance contrast on at least one pre-registered block."}]]}]]}],["$","div",null,{"className":"_sectionContent_r7ckf_32","children":[["$","p",null,{"children":"Each observation is a recording-level vector rather than an isolated frame. Candidate frequency blocks are fixed before labels are inspected. For a block B, the two group covariance estimates are combined into a pooled metric, and their difference is symmetrically whitened in that metric. The largest positive eigenvalue measures the strongest covariance increase that can be expressed inside B without committing to a direction in advance. Dividing by a block-specific scale and maximizing over the registered family produces one global statistic."}],"$L7","$L8","$L9","$La","$Lb"]}]]}]],"$Lc","$Ld","$Le"]}],"$Lf"]}]]}]]
