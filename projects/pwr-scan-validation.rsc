ath-render","dangerouslySetInnerHTML":{"__html":"$19"}}],"$L1a"]}],"$L1b"]}]],"$L1c","$L1d","$L1e","$L1f"]}]]}]]
e:[[["$","link","css:/assets/index-CtVCEiXV.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/assets/index-CtVCEiXV.css","data-rsc-css-href":"/assets/index-CtVCEiXV.css"}],"$undefined"],["$","section",null,{"className":"_section_r7ckf_27","id":"implementation-evidence","data-paper-section":true,"aria-labelledby":"implementation-evidence-title","children":[["$","header",null,{"className":"_sectionHead_r7ckf_28","children":[["$","span",null,{"children":"4"}],["$","div",null,{"children":[["$","h2",null,{"id":"implementation-evidence-title","children":"Implementation and empirical evidence"}],["$","p",null,{"children":"A compact synthetic console is kept next to the immutable engineering and external-data record."}]]}]]}],["$","div",null,{"className":"_sectionContent_r7ckf_32","children":[["$","p",null,{"children":"The implementation uses an independent deterministic oracle for pooled moments, whitening, scan aggregation, and small exact orbits. The engineering closeout completed 56 of 56 registered execution rows and 246 computational tests. These counts establish agreement with the oracle and software invariants; they do not estimate statistical power. Locked global-level and publication-scale campaigns remain labeled by their actual completion status."}],[[["$","link","css:/assets/index-CtVCEiXV.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/assets/index-CtVCEiXV.css","data-rsc-css-href":"/assets/index-CtVCEiXV.css"}],"$undefined"],["$","figure",null,{"className":"_figure_r7ckf_40","data-interactive":"true","children":[["$","div",null,{"className":"_figureBody_r7ckf_42","children":["$","$L20",null,{"evidence":{"release":"v0.3.0","commit":"624c21435d6172dfb7125cdc2c1c83e1765b3243","fingerprint":"b655ed9bb103dbf2eae1b56504e9b60f8d9b76195b2e1b225278e829e2354cfe","engineeringRuns":56,"computationalTests":246,"campaigns":[{"id":"V1","label":"Locked global-level study","status":"pending"},{"id":"V2","label":"Finite-sample power campaign","status":"pending"},{"id":"V3","label":"Rate campaign","status":"pending"},{"id":"V4","label":"Mismatch campaign","status":"pending"},{"id":"V5","label":"Adaptation campaign","status":"pending"}],"dcase":{"status":"negative","rocAuc":0.4843,"sensitivity":0,"interpretation":"The external DCASE check did not demonstrate discrimination. It is retained as negative evidence, not reframed as validation."}},"variant":"paper"}]}],["$","figcaption",null,{"children":[["$","b",null,{"children":["Figure ","1","."]}]," ","Interactive synthetic study. Controls select a precomputed deterministic row; the display is not an observed benchmark or a performance claim."]}]]}]],["$","h3",null,{"children":"External negative result"}],["$","p",null,{"children":"The retained DCASE aggregate produced ROC AUC 0.4843 and sensitivity 0. That result does not establish external validity and is intentionally shown rather than filtered out. Synthetic operating characteristics, implementation correctness, and performance on an external collection answer different questions; none substitutes for the others."}],[[["$","link","css:/assets/index-CtVCEiXV.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/assets/index-CtVCEiXV.css","data-rsc-css-href":"/assets/index-CtVCEiXV.css"}],"$undefined"],["$","aside",null,{"className":"_note_r7ckf_48","children":[["$","b",null,{"children":"Reproducibility"}],["$","div",null,{"children":["$","p",null,{"children":"The public release records the target release, commit, evidence fingerprint, study grid, and campaign status. Full proofs and the consolidated implementation are linked in References."}]}]]}]]]}]]}]]
f:["$","footer",null,{"className":"_references_r7ckf_51","id":"references","children":[["$","div",null,{"children":[["$","span",null,{"children":"Evidence boundary"}],["$","p",null,{"children":"Mathematical statements apply only under their displayed assumptions. Engineering tests, synthetic studies, and external-data performance are distinct evidence classes."}]]}],["$","div",null,{"children":[["$","span",null,{"children":"References"}],["$","a",null,{"href":"https://github.com/Moon-Young-Choi/pwr-scan","target":"_blank","rel":"noreferrer","children":"Source repository ↗"}]]}],["$","$L6",null,{"href":"/#projects","children":"Back to projects ↑"}]]}]
