1:[[["$","link","css:/assets/index-DStW-UAj.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/assets/index-DStW-UAj.css","data-rsc-css-href":"/assets/index-DStW-UAj.css"}],"$undefined"],[[["$","link","css:/assets/index-DStW-UAj.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/assets/index-DStW-UAj.css","data-rsc-css-href":"/assets/index-DStW-UAj.css"}],"$undefined"],["$","main",null,{"className":"_page_r7ckf_1","style":{"--paper-accent":"var(--ink)"},"children":[["$","header",null,{"className":"site-header _nav_r7ckf_2","children":[["$","$L6",null,{"className":"wordmark","href":"/","children":"MYC / 26"}],["$","nav",null,{"aria-label":"Bayesian Ad Targeting paper navigation","children":[["$","a",null,{"href":"#paper-contents","children":"Contents"}],["$","a",null,{"href":"#references","children":"References"}]]}],["$","$L6",null,{"className":"header-link","href":"/#projects","children":"Close ×"}]]}],["$","article",null,{"className":"_paper_r7ckf_3","children":[["$","header",null,{"className":"_masthead_r7ckf_4","data-paper-header":true,"children":[["$","div",null,{"className":"_runningHead_r7ckf_5","children":[["$","span",null,{"children":["Project ","06"]}],["$","span",null,{"children":"Offline incremental-effect allocation"}],["$","span",null,{"children":"Offline policy study"}]]}],["$","h1",null,{"children":"Bayesian Ad Targeting"}],["$","div",null,{"className":"_abstract_r7ckf_7","children":[["$","b",null,{"children":"Abstract."}],["$","p",null,{"children":"This project estimates incremental treatment effect from randomized advertising logs and allocates a limited budget under posterior uncertainty. It separates response prediction from causal uplift, uses arm-specific Beta–Bernoulli posteriors with parent-reference pooling, admits segments through an economic probability gate, and ranks eligible actions by Thompson-sampled net value. Three compact labs expose the decision mechanics; an independent 500,000-row benchmark remains separate from their illustrative defaults."}]]}],["$","dl",null,{"className":"_metadata_r7ckf_10","children":[["$","div","Evidence",{"children":[["$","dt",null,{"children":"Evidence"}],["$","dd",null,{"children":"Randomized treatment logs"}]]}],["$","div","Model",{"children":[["$","dt",null,{"children":"Model"}],["$","dd",null,{"children":"Beta–Bernoulli"}]]}],["$","div","Policy",{"children":[["$","dt",null,{"children":"Policy"}],["$","dd",null,{"children":"Thompson allocation"}]]}],["$","div","Mode",{"children":[["$","dt",null,{"children":"Mode"}],["$","dd",null,{"children":"Offline CLI"}]]}]]}],["$","p",null,{"className":"_keywords_r7ckf_16","children":[["$","b",null,{"children":"Keywords."}]," ","Python · NumPy · pandas · Beta–Bernoulli inference · Thompson Sampling"]}],["$","details",null,{"className":"_contents_r7ckf_18","id":"paper-contents","data-paper-toc":true,"children":[["$","summary",null,{"children":["Contents — ",4," sections"]}],["$","ol",null,{"children":[["$","li","identification",{"children":["$","a",null,{"href":"#identification","children":[["$","span",null,{"children":"1"}],"Identification and uplift segmentation"]}]}],["$","li","posterior",{"children":["$","a",null,{"href":"#posterior","children":[["$","span",null,{"children":"2"}],"Posterior inference"]}]}],["$","li","policy-labs",{"children":["$","a",null,{"href":"#policy-labs","children":[["$","span",null,{"children":"3"}],"Interactive policy labs"]}]}],["$","li","allocation-evidence",{"children":["$","a",null,{"href":"#allocation-evidence","children":[["$","span",null,{"children":"4"}],"Allocation and independent evidence"]}]}]]}]]}]]}],["$","div",null,{"className":"_body_r7ckf_26","children":[[[["$","link","css:/assets/index-DStW-UAj.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/assets/index-DStW-UAj.css","data-rsc-css-href":"/assets/index-DStW-UAj.css"}],"$undefined"],["$","section",null,{"className":"_section_r7ckf_27","id":"identifica