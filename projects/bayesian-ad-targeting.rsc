data-rsc-css-href":"/assets/index-DStW-UAj.css"}],"$undefined"],["$","figure",null,{"className":"_equation_r7ckf_37","aria-label":"Arm posterior and uplift draw","children":[["$","div",null,{"children":[["$","div",null,{"className":"math-render","dangerouslySetInnerHTML":{"__html":"$11"}}],"$L12"]}],"$L13"]}]],"$L14","$L15"]}]]}]]
9:[[["$","link","css:/assets/index-DStW-UAj.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/assets/index-DStW-UAj.css","data-rsc-css-href":"/assets/index-DStW-UAj.css"}],"$undefined"],["$","section",null,{"className":"_section_r7ckf_27","id":"policy-labs","data-paper-section":true,"aria-labelledby":"policy-labs-title","children":[["$","header",null,{"className":"_sectionHead_r7ckf_28","children":[["$","span",null,{"children":"3"}],["$","div",null,{"children":[["$","h2",null,{"id":"policy-labs-title","children":"Interactive policy labs"}],["$","p",null,{"children":"The three labs preserve the original controls while using smaller numbered figures inside the paper column."}]]}]]}],["$","div",null,{"className":"_sectionContent_r7ckf_32","children":[["$","p",null,{"children":"Split Value contrasts a baseline-shift counterexample with genuine uplift heterogeneity. Posterior & Pooling changes replay evidence, prior strength, and the selected child to expose shrinkage and profitability probability. Decision Lab varies economic value, treatment cost, budget, and segment cap before drawing and allocating a new Thompson sample. All values are seeded illustrative calculations and are never mixed with the independent benchmark."}],[[["$","link","css:/assets/index-DStW-UAj.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/assets/index-DStW-UAj.css","data-rsc-css-href":"/assets/index-DStW-UAj.css"}],"$undefined"],["$","figure",null,{"className":"_figure_r7ckf_40","data-interactive":"true","children":[["$","div",null,{"className":"_figureBody_r7ckf_42","children":["$","$L16",null,{"variant":"paper"}]}],["$","figcaption",null,{"children":[["$","b",null,{"children":["Figure ","1","."]}]," ","Interactive Split Value, Posterior & Pooling, and Decision labs. Each lab announces updated results to assistive technology."]}]]}]],["$","p",null,{"children":"The counterexample matters operationally. A model can achieve a large marginal likelihood improvement by splitting two groups with different baseline response but equal treatment effect. Such a split increases complexity without changing whom the policy should treat. Requiring both structural evidence and posterior expected policy gain aligns segmentation with the later allocation objective."}]]}]]}]]
17:T286e,<span class="katex-display"><span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><mi>Pr</mi><mo>⁡</mo><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Δ</mi><mi mathvariant="normal">ℓ</mi></msub><mo>&gt;</mo><mi>c</mi><mi mathvariant="normal">/</mi><mi>v</mi><mo>∣</mo><mi>D</mi><mo stretchy="false">)</mo><mo>≥</mo><mi>τ</mi><mo separator="true">,</mo><mspace width="2em"/><msub><mover accent="true"><mi>u</mi><mo stretchy="true">~</mo></mover><mi mathvariant="normal">ℓ</mi></msub><mo>=</mo><mi>v</mi><msub><mover accent="true"><mi mathvariant="normal">Δ</mi><mo stretchy="true">~</mo></mover><mi mathvariant="normal">ℓ</mi></msub><mo>−</mo><mi>c</mi><mo separator="true">,</mo><mspace width="2em"/><munder><mrow><mi>max</mi><mo>⁡</mo></mrow><mrow><mi mathvariant="bold">x</mi><mo>∈</mo><mi mathvariant="script">F</mi></mrow></munder><munder><mo>∑</mo><mi mathvariant="normal">ℓ</mi></munder><msub><mi>x</mi><mi mathvariant="normal">ℓ</mi></msub><msub><mover accent="true"><mi>u</mi><mo stretchy="true">~</mo></mover><mi mathvariant="normal">ℓ</mi></msub></mrow><annotation encoding="application/x-tex">\Pr(\Delta_\ell&gt;c/v\mid D)\ge\tau,\qquad \widetilde u_\ell=v\widetilde\Delta_\ell-c,\qquad \max_{\mathbf x\in\mathcal F}\sum_\ell x_\ell\widetilde u_\ell</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="katex-base"><span class="katex-strut" style="height:1em;vertical-align:-0.25em;"></span><span class="mop">Pr</span><span class="mopen">(</span><span class="mord"><span class="mord">Δ</span><span class="msupsub"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height:0.3361em;"><span style="top:-2.55em;margin-left:0em;margin-right:0.05em;"><span class="pstrut" style="height:2.7em;"></span><span class="katex-sizing reset-size6 size3 mtight"><span class="mord mtight">ℓ</span></span></span></span><span class="vlist-s