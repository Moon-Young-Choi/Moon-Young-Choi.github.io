e:["$","figcaption",null,{"children":[["$","b",null,{"children":["Admissible information and entry session","."]}]," ","D_i is the disclosure cutoff. E_i is the first complete tradable session after that cutoff."]}]
f:["$","h3",null,{"children":"Correction families"}]
10:["$","p",null,{"children":"Original, corrected, and amended filings that describe the same corporate event form one correction family. A family is assigned wholly to one chronological partition. The usable version for an observation is the latest member available before its cutoff; later corrections cannot rewrite an earlier training snapshot. This prevents near-duplicate text and retrospective information from crossing train, validation, and test boundaries."}]
11:[[["$","link","css:/assets/index-DStW-UAj.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/assets/index-DStW-UAj.css","data-rsc-css-href":"/assets/index-DStW-UAj.css"}],"$undefined"],["$","ol",null,{"className":"_flow_r7ckf_43","children":[["$","li","DART/FSC cutoff",{"children":[["$","span",null,{"children":"01"}],["$","b",null,{"children":"DART/FSC cutoff"}]]}],["$","li","Correction-family snapshot",{"children":[["$","span",null,{"children":"02"}],["$","b",null,{"children":"Correction-family snapshot"}]]}],["$","li","Eligible session open",{"children":[["$","span",null,{"children":"03"}],["$","b",null,{"children":"Eligible session open"}]]}],["$","li","Mature return label",{"children":[["$","span",null,{"children":"04"}],["$","b",null,{"children":"Mature return label"}]]}]]}]]
